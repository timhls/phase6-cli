# KeePass database path (override via $KDBX, defaults to user's standard location).
KDBX="${KDBX:-$HOME/KeePassXC/keepass.kdbx}"

# 1. Trigger a macOS GUI prompt to ask for the database password
DB_PASS=$(osascript -e 'Tell application "System Events" to display dialog "Enter KeePassXC Password:" default answer "" with hidden answer' -e 'text returned of result')

# 2. Define the entry title
ENTRY_TITLE="phase6"

# 3. Fetch the username and export it as an environment variable
export PHASE6_USERNAME=$(echo "$DB_PASS" | keepassxc-cli show -q -s -a username "$KDBX" "$ENTRY_TITLE")

# 4. Fetch the password and export it as an environment variable
export PHASE6_PASSWORD=$(echo "$DB_PASS" | keepassxc-cli show -q -s -a password "$KDBX" "$ENTRY_TITLE")

# 5. Clean up the master password variable for security
unset DB_PASS
